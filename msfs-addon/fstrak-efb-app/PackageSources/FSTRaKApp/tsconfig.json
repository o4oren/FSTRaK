{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ES2020",
    "moduleResolution": "node",
    "jsx": "react",
    "jsxFactory": "FSComponent.Fragment ? FSComponent.create : undefined",
    "lib": ["ES2017", "DOM"],
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "paths": {
      "@efb/efb-api": ["../efb_api/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*"]
}
