<UserControl x:Class="FSTRaK.Views.ClientDetailPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:FSTRaK.ViewModels"
             xmlns:utils="clr-namespace:FSTRaK.Utils"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SelectedClientViewModel}"
             Width="300">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Images.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <utils:NullToVisibilityConverter      x:Key="NullToVis"/>
            <utils:BoolToVisibilityConverter      x:Key="BoolToVis"/>

            <Style x:Key="StatTile" TargetType="Border">
                <Setter Property="Background"    Value="Transparent"/>
                <Setter Property="CornerRadius"  Value="4"/>
                <Setter Property="Padding"       Value="5,4"/>
            </Style>
            <Style x:Key="StatValue" TargetType="TextBlock">
                <Setter Property="Foreground"          Value="{DynamicResource SuperBrightTextColor}"/>
                <Setter Property="FontWeight"          Value="Bold"/>
                <Setter Property="FontSize"            Value="{DynamicResource HeaderFontSize}"/>
                <Setter Property="FontFamily"          Value="{DynamicResource CurrentFont}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="StatLabel" TargetType="TextBlock">
                <Setter Property="Foreground"          Value="{DynamicResource BrightTextColor}"/>
                <Setter Property="FontSize"            Value="{DynamicResource TextFontSize}"/>
                <Setter Property="FontFamily"          Value="{DynamicResource CurrentFont}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Opacity"             Value="0.6"/>
            </Style>
            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="Foreground"  Value="{DynamicResource BrightTextColor}"/>
                <Setter Property="FontSize"    Value="9"/>
                <Setter Property="FontFamily"  Value="{DynamicResource CurrentFont}"/>
                <Setter Property="Opacity"     Value="0.45"/>
                <Setter Property="Margin"      Value="0,0,0,2"/>
            </Style>
            <Style x:Key="DimText" TargetType="TextBlock">
                <Setter Property="Foreground"  Value="{DynamicResource BrightTextColor}"/>
                <Setter Property="FontFamily"  Value="{DynamicResource CurrentFont}"/>
                <Setter Property="FontSize"    Value="{DynamicResource TextFontSize}"/>
                <Setter Property="Opacity"     Value="0.65"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="#B3000000"
            CornerRadius="5"
            Padding="10"
            MaxHeight="600">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent" Width="6">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="{DynamicResource BrightTextColor}"
                                                                CornerRadius="3" Opacity="0.5"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ScrollViewer.Resources>
        <StackPanel>

            <!-- ── Header row: callsign left, logo + close right ── -->
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Cursor="Hand" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Padding="4,0"
                        Click="CloseButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock x:Name="CloseText" Text="×" FontSize="18"
                                       Foreground="{DynamicResource BrightTextColor}"
                                       Opacity="0.6"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseText" Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Grid Width="48" Height="24" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,4,0">
                    <ContentControl Content="{DynamicResource VatsimLogo}"
                                    Visibility="{Binding IsVatsim, Converter={StaticResource BoolToVis}}"/>
                    <ContentControl Content="{DynamicResource IvaoLogo}"
                                    Visibility="{Binding IsIvao, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <TextBlock Text="{Binding Callsign}"
                           Foreground="{DynamicResource SuperBrightTextColor}"
                           FontWeight="Bold"
                           FontSize="{DynamicResource HeaderFontSize}"
                           FontFamily="{DynamicResource CurrentFont}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
            </DockPanel>

            <!-- ══════════════ PILOT PANEL ══════════════ -->
            <StackPanel Visibility="{Binding IsPilot, Converter={StaticResource BoolToVis}}">

                <!-- Pilot info row -->
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="{Binding PilotName}" Style="{StaticResource DimText}"/>
                    <TextBlock Text="{Binding AircraftType}" Style="{StaticResource DimText}"/>
                </StackPanel>

                <!-- Route bar -->
                <Border Background="Transparent" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Departure}"
                                       Foreground="{DynamicResource SuperBrightTextColor}"
                                       FontWeight="Bold" FontFamily="{DynamicResource CurrentFont}"
                                       FontSize="{DynamicResource HeaderFontSize}"/>
                            <Grid Grid.Column="1" Margin="6,0">
                                <Rectangle Height="1" Fill="{DynamicResource BrightTextColor}" VerticalAlignment="Center" Opacity="0.4"/>
                                <TextBlock Text="✈" Foreground="{DynamicResource SuperBrightTextColor}"
                                           FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="45" CenterX="5" CenterY="5"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{Binding Arrival}"
                                       Foreground="{DynamicResource BrightTextColor}"
                                       FontWeight="Bold" FontFamily="{DynamicResource CurrentFont}"
                                       FontSize="{DynamicResource HeaderFontSize}" Opacity="0.75"/>
                        </Grid>
                        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="3"
                                     Background="#33FFFFFF" BorderThickness="0" Margin="0,0,0,3"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource DimText}"
                                       FontSize="{DynamicResource TextFontSize}">
                                <Run Text="{Binding ProgressPercent, StringFormat={}{0:F0}%, Mode=OneWay}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding RemainingNmDisplay, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding EtaDisplay}" DockPanel.Dock="Right"
                                       Style="{StaticResource DimText}"
                                       FontSize="{DynamicResource TextFontSize}"
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Stats grid 3×2 -->
                <UniformGrid Columns="3" Margin="0,0,0,6">
                    <Border Style="{StaticResource StatTile}" Margin="0,0,2,2">
                        <StackPanel>
                            <TextBlock Text="{Binding Altitude, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}"/>
                            <TextBlock Text="ALT ft" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}" Margin="1,0,1,2">
                        <StackPanel>
                            <TextBlock Text="{Binding Groundspeed}" Style="{StaticResource StatValue}"/>
                            <TextBlock Text="GS kts" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}" Margin="2,0,0,2">
                        <StackPanel>
                            <TextBlock Text="{Binding Heading, StringFormat={}{0}°}" Style="{StaticResource StatValue}"/>
                            <TextBlock Text="HDG" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}" Margin="0,2,2,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Squawk}" Style="{StaticResource StatValue}"/>
                            <TextBlock Text="SQWK" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}" Margin="1,2,1,0">
                        <StackPanel>
                            <TextBlock Text="{Binding CruiseAlt}" Style="{StaticResource StatValue}"/>
                            <TextBlock Text="CRZ ALT" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}" Margin="2,2,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding OnlineTime}" Style="{StaticResource StatValue}"/>
                            <TextBlock Text="ONLINE" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Route string -->
                <Border Background="Transparent" CornerRadius="4" Padding="6,4" Margin="0,0,0,4"
                        Visibility="{Binding RouteString, Converter={StaticResource NullToVis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,2">
                            <TextBlock DockPanel.Dock="Left" Text="ROUTE" Style="{StaticResource SectionLabel}" Margin="0"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding FlightRules}"
                                       Foreground="#FF34D399" FontSize="9" FontWeight="Bold"
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock Text="{Binding RouteString}" Style="{StaticResource DimText}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Remarks -->
                <Border Background="Transparent" CornerRadius="4" Padding="6,4"
                        Visibility="{Binding Remarks, Converter={StaticResource NullToVis}}">
                    <StackPanel>
                        <TextBlock Text="REMARKS" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding Remarks}" Style="{StaticResource DimText}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ══════════════ AIRPORT ATC PANEL ══════════════ -->
            <StackPanel Visibility="{Binding IsAirportATC, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding AirportName}" Style="{StaticResource DimText}" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding FacilityLabel}" Style="{StaticResource DimText}" Opacity="0.5" Margin="0,0,0,8"/>

                <Border Background="Transparent" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                    <ItemsControl ItemsSource="{Binding Controllers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3,0,0">
                                    <!-- Line 1: callsign + position + frequency -->
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Callsign}"
                                                   Foreground="{DynamicResource SuperBrightTextColor}"
                                                   FontFamily="{DynamicResource CurrentFont}"
                                                   FontSize="{DynamicResource TextFontSize}" FontWeight="SemiBold"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Position}"
                                                   Foreground="{DynamicResource BrightTextColor}"
                                                   FontFamily="{DynamicResource CurrentFont}"
                                                   FontSize="{DynamicResource TextFontSize}"
                                                   Opacity="0.6" Margin="0,0,6,0"/>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Frequency}"
                                                   Foreground="{DynamicResource BrightTextColor}"
                                                   FontFamily="{DynamicResource CurrentFont}"
                                                   FontSize="{DynamicResource TextFontSize}" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <!-- Line 2: name + rating + online time -->
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Name}"
                                                   Foreground="{DynamicResource BrightTextColor}"
                                                   FontFamily="{DynamicResource CurrentFont}"
                                                   FontSize="{DynamicResource TextFontSize}"
                                                   Opacity="0.6" Margin="0,0,6,0"/>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Rating}"
                                                   Foreground="{DynamicResource BrightTextColor}"
                                                   FontFamily="{DynamicResource CurrentFont}"
                                                   FontSize="{DynamicResource TextFontSize}"
                                                   Opacity="0.5" Margin="0,0,6,0"/>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding OnlineTime}"
                                                   Foreground="{DynamicResource BrightTextColor}"
                                                   FontFamily="{DynamicResource CurrentFont}"
                                                   FontSize="{DynamicResource TextFontSize}"
                                                   Opacity="0.5"/>
                                    </DockPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Border Background="Transparent" CornerRadius="4" Padding="6,4"
                        Visibility="{Binding AtisText, Converter={StaticResource NullToVis}}">
                    <StackPanel>
                        <TextBlock Text="ATIS" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding AtisText}" Style="{StaticResource DimText}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ══════════════ CTR / APP / FSS PANEL ══════════════ -->
            <StackPanel Visibility="{Binding IsCtrATC, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding FacilityLabel}" Style="{StaticResource DimText}" Margin="0,0,0,8"/>

                <Border Background="Transparent" CornerRadius="4" Padding="8,6" Margin="0,0,0,4">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Margin="0,0,16,0">
                            <TextBlock Text="{Binding Frequency}"
                                       Foreground="{DynamicResource SuperBrightTextColor}"
                                       FontFamily="{DynamicResource CurrentFont}"
                                       FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="MHz" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="{Binding RatingDisplay}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="RATING" Style="{StaticResource StatLabel}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding OnlineTime}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="ONLINE" Style="{StaticResource StatLabel}"/>
                            </StackPanel>
                        </UniformGrid>
                    </DockPanel>
                </Border>

                <Border Background="Transparent" CornerRadius="4" Padding="6,4"
                        Visibility="{Binding AtisText, Converter={StaticResource NullToVis}}">
                    <StackPanel>
                        <TextBlock Text="ATIS" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding AtisText}" Style="{StaticResource DimText}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
