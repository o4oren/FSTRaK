<UserControl x:Class="FSTRaK.Views.ClientDetailPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:FSTRaK.ViewModels"
             xmlns:utils="clr-namespace:FSTRaK.Utils"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SelectedClientViewModel}"
             Width="260">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Images.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <utils:NullToVisibilityConverter x:Key="NullToVis"/>
            <utils:InvertedNullToVisibilityConverter x:Key="InvertedNullToVis"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <Style x:Key="StatTile" TargetType="Border">
                <Setter Property="Background" Value="#44000000"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="5,4"/>
            </Style>

            <Style x:Key="StatValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SuperBrightTextColor}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="{DynamicResource TextFontSize}"/>
                <Setter Property="FontFamily" Value="{DynamicResource CurrentFont}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="StatLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource BrightTextColor}"/>
                <Setter Property="FontSize" Value="8"/>
                <Setter Property="FontFamily" Value="{DynamicResource CurrentFont}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Opacity" Value="0.55"/>
            </Style>

            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource BrightTextColor}"/>
                <Setter Property="FontSize" Value="8"/>
                <Setter Property="FontFamily" Value="{DynamicResource CurrentFont}"/>
                <Setter Property="Opacity" Value="0.4"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource OverlayBackgroundBrush}"
            BorderBrush="{DynamicResource BrightTextColor}"
            BorderThickness="1"
            CornerRadius="5"
            Padding="10">
        <StackPanel>
            <!-- Close button row -->
            <DockPanel Margin="0,0,0,6">
                <!-- Network logo -->
                <Grid Width="20" Height="14" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Image Source="/Resources/Images/VATSIM_Logo_White_No_Tagline_500px.png"
                           Stretch="Uniform"
                           Visibility="{Binding IsVatsim, Converter={StaticResource BoolToVis}}"/>
                    <ContentControl Content="{DynamicResource IvaoLogo}"
                                    Visibility="{Binding IsIvao, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <Button Content="×" DockPanel.Dock="Right"
                        FontSize="14" Foreground="{DynamicResource BrightTextColor}"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Padding="4,0"
                        Click="CloseButton_Click"/>
                <!-- Callsign -->
                <TextBlock Text="{Binding Callsign}"
                           Foreground="{DynamicResource SuperBrightTextColor}"
                           FontWeight="Bold"
                           FontSize="{DynamicResource HeaderFontSize}"
                           FontFamily="{DynamicResource CurrentFont}"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <!-- ═══ PILOT PANEL ═══ -->
            <StackPanel Visibility="{Binding IsPilot, Converter={StaticResource BoolToVis}}">

                <!-- Pilot name + IFR badge -->
                <DockPanel Margin="0,0,0,8">
                    <!-- Airline logo box -->
                    <Border Width="36" Height="36" DockPanel.Dock="Left" Margin="0,0,8,0"
                            Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Image Source="{Binding AirlineLogo}" Stretch="Uniform" Margin="3"
                                   Visibility="{Binding AirlineLogo, Converter={StaticResource NullToVis}}"/>
                            <TextBlock Text="{Binding Callsign}" Foreground="{DynamicResource BrightTextColor}"
                                       FontSize="7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding AirlineLogo, Converter={StaticResource InvertedNullToVis}}"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PilotName}"
                                   Foreground="{DynamicResource BrightTextColor}"
                                   FontFamily="{DynamicResource CurrentFont}"
                                   FontSize="{DynamicResource TextFontSize}"
                                   Opacity="0.75"/>
                        <DockPanel>
                            <Border Background="#2034D399" BorderBrush="#4034D399" BorderThickness="1"
                                    CornerRadius="3" Padding="4,1" Margin="0,0,6,0" DockPanel.Dock="Left">
                                <TextBlock Text="{Binding FlightRules}" Foreground="#FF34D399"
                                           FontSize="8" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="{Binding AircraftType}"
                                       Foreground="{DynamicResource BrightTextColor}"
                                       FontFamily="{DynamicResource CurrentFont}"
                                       FontSize="{DynamicResource TextFontSize}"
                                       Opacity="0.65"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </DockPanel>

                <!-- Route bar -->
                <Border Background="#33000000" CornerRadius="4" Padding="8,5" Margin="0,0,0,6">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Departure}"
                                       Foreground="{DynamicResource SuperBrightTextColor}"
                                       FontWeight="Bold"
                                       FontFamily="{DynamicResource CurrentFont}"
                                       FontSize="{DynamicResource HeaderFontSize}"/>
                            <Grid Grid.Column="1" Margin="6,0">
                                <Rectangle Height="1" Fill="#44FFFFFF" VerticalAlignment="Center"/>
                                <TextBlock Text="✈" Foreground="{DynamicResource BrightTextColor}"
                                           FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{Binding Arrival}"
                                       Foreground="{DynamicResource BrightTextColor}"
                                       FontWeight="Bold"
                                       FontFamily="{DynamicResource CurrentFont}"
                                       FontSize="{DynamicResource HeaderFontSize}"
                                       Opacity="0.7"/>
                        </Grid>
                        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="3"
                                     Background="#33FFFFFF" BorderThickness="0" Margin="0,0,0,3"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       Foreground="{DynamicResource BrightTextColor}"
                                       FontFamily="{DynamicResource CurrentFont}"
                                       FontSize="8" Opacity="0.55">
                                <Run Text="{Binding ProgressPercent, StringFormat={}{0:F0}%, Mode=OneWay}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding RemainingNmDisplay, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding EtaDisplay}" DockPanel.Dock="Right"
                                       Foreground="{DynamicResource BrightTextColor}"
                                       FontFamily="{DynamicResource CurrentFont}"
                                       FontSize="8" Opacity="0.55"
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Stats grid -->
                <UniformGrid Columns="3" Margin="0,0,0,6">
                    <Border Style="{StaticResource StatTile}" Margin="0,0,2,2">
                        <StackPanel>
                            <TextBlock Text="{Binding Altitude, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}"/>
                            <TextBlock Text="ALT ft" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}" Margin="1,0,1,2">
                        <StackPanel>
                            <TextBlock Text="{Binding Groundspeed}" Style="{StaticResource StatValue}"/>
                            <TextBlock Text="GS kts" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}" Margin="2,0,0,2">
                        <StackPanel>
                            <TextBlock Text="{Binding Heading, StringFormat={}{0}°}" Style="{StaticResource StatValue}"/>
                            <TextBlock Text="HDG" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}" Margin="0,2,2,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Squawk}" Style="{StaticResource StatValue}"/>
                            <TextBlock Text="SQWK" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}" Margin="1,2,1,0">
                        <StackPanel>
                            <TextBlock Text="{Binding CruiseAlt}" Style="{StaticResource StatValue}"/>
                            <TextBlock Text="CRZ ALT" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}" Margin="2,2,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding OnlineTime}" Style="{StaticResource StatValue}"/>
                            <TextBlock Text="ONLINE" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Route -->
                <Border Background="#33000000" CornerRadius="4" Padding="6,4" Margin="0,0,0,4"
                        Visibility="{Binding RouteString, Converter={StaticResource NullToVis}}">
                    <StackPanel>
                        <TextBlock Text="ROUTE" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding RouteString}"
                                   Foreground="{DynamicResource BrightTextColor}"
                                   FontFamily="Courier New"
                                   FontSize="{DynamicResource TextFontSize}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Opacity="0.75"/>
                    </StackPanel>
                </Border>

                <!-- Remarks -->
                <Border Background="#33000000" CornerRadius="4" Padding="6,4"
                        Visibility="{Binding Remarks, Converter={StaticResource NullToVis}}">
                    <StackPanel>
                        <TextBlock Text="REMARKS" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding Remarks}"
                                   Foreground="{DynamicResource BrightTextColor}"
                                   FontFamily="{DynamicResource CurrentFont}"
                                   FontSize="{DynamicResource TextFontSize}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Opacity="0.65"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═══ AIRPORT ATC PANEL ═══ -->
            <StackPanel Visibility="{Binding IsAirportATC, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding AirportName}"
                           Foreground="{DynamicResource BrightTextColor}"
                           FontFamily="{DynamicResource CurrentFont}"
                           FontSize="{DynamicResource TextFontSize}"
                           Opacity="0.65" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding FacilityLabel}"
                           Foreground="{DynamicResource BrightTextColor}"
                           FontFamily="{DynamicResource CurrentFont}"
                           FontSize="{DynamicResource TextFontSize}"
                           Opacity="0.55" Margin="0,0,0,8"/>

                <Border Background="#33000000" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                    <ItemsControl ItemsSource="{Binding Controllers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Callsign}"
                                               Foreground="{DynamicResource SuperBrightTextColor}"
                                               FontFamily="{DynamicResource CurrentFont}"
                                               FontSize="{DynamicResource TextFontSize}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Position}"
                                               Foreground="{DynamicResource BrightTextColor}"
                                               FontFamily="{DynamicResource CurrentFont}"
                                               FontSize="{DynamicResource TextFontSize}"
                                               Opacity="0.6" Margin="6,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Frequency}"
                                               Foreground="{DynamicResource BrightTextColor}"
                                               FontFamily="{DynamicResource CurrentFont}"
                                               FontSize="{DynamicResource TextFontSize}"
                                               Margin="6,0,0,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding OnlineTime}"
                                               Foreground="{DynamicResource BrightTextColor}"
                                               FontFamily="{DynamicResource CurrentFont}"
                                               FontSize="{DynamicResource TextFontSize}"
                                               Opacity="0.5" Margin="6,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Border Background="#33000000" CornerRadius="4" Padding="6,4"
                        Visibility="{Binding AtisText, Converter={StaticResource NullToVis}}">
                    <StackPanel>
                        <TextBlock Text="ATIS" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding AtisText}"
                                   Foreground="{DynamicResource BrightTextColor}"
                                   FontFamily="{DynamicResource CurrentFont}"
                                   FontSize="{DynamicResource TextFontSize}"
                                   TextWrapping="Wrap" MaxHeight="80" Opacity="0.75"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═══ CTR / APP / FSS PANEL ═══ -->
            <StackPanel Visibility="{Binding IsCtrATC, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding FacilityLabel}"
                           Foreground="{DynamicResource BrightTextColor}"
                           FontFamily="{DynamicResource CurrentFont}"
                           FontSize="{DynamicResource TextFontSize}"
                           Opacity="0.55" Margin="0,0,0,8"/>

                <Border Background="#33000000" CornerRadius="4" Padding="8,6" Margin="0,0,0,4">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Margin="0,0,16,0">
                            <TextBlock Text="{Binding Frequency}"
                                       Foreground="{DynamicResource SuperBrightTextColor}"
                                       FontFamily="{DynamicResource CurrentFont}"
                                       FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="MHz"
                                       Foreground="{DynamicResource BrightTextColor}"
                                       FontFamily="{DynamicResource CurrentFont}"
                                       FontSize="8" Opacity="0.5"/>
                        </StackPanel>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="{Binding RatingDisplay}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="RATING" Style="{StaticResource StatLabel}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding OnlineTime}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="ONLINE" Style="{StaticResource StatLabel}"/>
                            </StackPanel>
                        </UniformGrid>
                    </DockPanel>
                </Border>

                <Border Background="#33000000" CornerRadius="4" Padding="6,4"
                        Visibility="{Binding AtisText, Converter={StaticResource NullToVis}}">
                    <StackPanel>
                        <TextBlock Text="ATIS" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding AtisText}"
                                   Foreground="{DynamicResource BrightTextColor}"
                                   FontFamily="{DynamicResource CurrentFont}"
                                   FontSize="{DynamicResource TextFontSize}"
                                   TextWrapping="Wrap" MaxHeight="80" Opacity="0.75"/>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
