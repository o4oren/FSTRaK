<UserControl x:Class="FSTRaK.Views.EditAircraftPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:FSTRaK.ViewModels"
             mc:Ignorable="d"
             Style="{DynamicResource GlobalFont}"
             d:DataContext="{d:DesignInstance Type=viewModels:EditAircraftViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Popup
        Name="EditAircraftPopup"
        IsOpen="{Binding IsShow}"
        PlacementTarget="{Binding ElementName=EditAircraftPopup}"
        Placement="MousePoint"
    >
        <Border
            BorderBrush="{DynamicResource BorderMidColorBrush}"
            Background="{DynamicResource PrimaryLightBrush}"
            BorderThickness="1"
            Padding="10"
        >
            <Grid>
                <Grid.Resources>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="FontFamily" Value="{DynamicResource CurrentFont}"/>
                        <Setter Property="FontSize" Value="{DynamicResource ListFontSize}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                        <Setter Property="Margin" Value="5"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Grid.Row="0">Title</TextBlock>
                <TextBlock Grid.Column="1" Grid.Row="0"
                    Foreground="{DynamicResource UnselectedTextColor}"
                    Text="{Binding Aircraft.Title}"
                    TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Column="0" Grid.Row="1">Manufacturer</TextBlock>
                <TextBox Grid.Column="1" Grid.Row="1" Style="{DynamicResource FSTrAkTextBox}" Margin="5"
                    Text="{Binding Aircraft.Manufacturer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Column="0" Grid.Row="2">Type</TextBlock>
                <TextBox Grid.Column="1" Grid.Row="2" Style="{DynamicResource FSTrAkTextBox}" Margin="5"
                    Text="{Binding Aircraft.AircraftType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Column="0" Grid.Row="3">Model</TextBlock>
                <TextBox Grid.Column="1" Grid.Row="3" Style="{DynamicResource FSTrAkTextBox}" Margin="5"
                    Text="{Binding Aircraft.Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Column="0" Grid.Row="4">Airline</TextBlock>
                <TextBox Grid.Column="1" Grid.Row="4" Style="{DynamicResource FSTrAkTextBox}" Margin="5"
                    Text="{Binding Aircraft.Airline, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Column="0" Grid.Row="5">Tail Number</TextBlock>
                <TextBox Grid.Column="1" Grid.Row="5" Style="{DynamicResource FSTrAkTextBox}" Margin="5"
                    Text="{Binding Aircraft.TailNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <StackPanel Grid.Column="0" Grid.Row="6" Grid.ColumnSpan="2"
                    Orientation="Horizontal" Margin="5,8,5,3">
                    <Button Command="{Binding UpdateAircraft}" Width="100" Margin="0,0,8,0">Save</Button>
                    <Button Command="{Binding ClosePopup}" Width="100">Close</Button>
                </StackPanel>
            </Grid>
        </Border>
    </Popup>
</UserControl>
