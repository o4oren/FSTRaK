<UserControl x:Class="FSTRaK.Views.LiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:map="clr-namespace:MapControl;assembly=MapControl.WPF"
             xmlns:utils="clr-namespace:FSTRaK.Utils"
             xmlns:viewmodels="clr-namespace:FSTRaK.ViewModels" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:views="clr-namespace:FSTRaK.Views"
             xmlns:dataTypes="clr-namespace:FSTRaK.DataTypes"
             d:DataContext="{d:DesignInstance Type=viewmodels:LiveViewViewModel}"
             mc:Ignorable="d" 
             Loaded="OnLoaded"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary x:Name="mainViewResources">
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/AircraftIconsDictionary.xaml"/>
                <ResourceDictionary Source="../Resources/MapProvidersDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <utils:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
            <utils:NetworkTypeToVisConverter x:Key="NetworkTypeToVisConverter"/>
            <utils:NullToVisibilityConverter x:Key="NullToVisConverter"/>
<utils:StringToSolidColorBrushConverter x:Key="StringToColorBrushConverter"/>
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="#CC1a2a3a"/>
                <Setter Property="Foreground" Value="#DDFFFFFF"/>
                <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <map:Map x:Name="xMap"
                 ZoomLevel="{Binding ZoomLevel}"
                 MapProjection="{StaticResource WebMercatorProjection}"
                 Center="{Binding MapCenter, Mode=TwoWay}"
                 MaxZoomLevel="18"
                 MinZoomLevel="3"
                 Margin="10,10,10,10">
            <b:Interaction.Triggers>
                <b:EventTrigger EventName="MouseLeftButtonDown">
                    <b:InvokeCommandAction Command="{Binding StopCenterOnAirplaneCommand}"/>
                </b:EventTrigger>
            </b:Interaction.Triggers>
            <map:MapScale Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="5" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5">
                <TextBlock FontSize="12" Style="{DynamicResource MapAttribution}"
                           utils:HyperlinkText.InlinesSource="{Binding MapAttributionText}" />
                <TextBlock FontSize="12" Foreground="Red" FontWeight="Bold" Margin="8,0,0,0" Text="Not for navigational use" />
            </StackPanel>
            <ContentControl HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10 0 0 15" Width="45" Height="11" Visibility="{Binding IsMaptillerCMap, Converter={StaticResource BoolToVis}}">
                <Hyperlink NavigateUri="https://www.maptiler.com/"
                           TextDecorations="None"
                           RequestNavigate="Hyperlink_RequestNavigate">
                    <ContentControl Content="{DynamicResource MaptillerLogo}"/>
                </Hyperlink>
            </ContentControl>
            <!-- SimBrief planned route overlay -->
            <map:MapPolyline Locations="{Binding PlannedRouteLocations}"
                             Stroke="{DynamicResource PlannedPathColorBrush}" StrokeThickness="2"
                             StrokeDashArray="4 2" Opacity="0.8"
                             Visibility="{Binding IsShowFlightPlanOverlay, Converter={StaticResource BoolToVis}}"/>
            <map:MapItemsControl ItemsSource="{Binding PlannedWaypoints}"
                                 Visibility="{Binding IsShowFlightPlanOverlay, Converter={StaticResource BoolToVis}}">
                <map:MapItemsControl.ItemContainerStyle>
                    <Style TargetType="map:MapItem">
                        <Setter Property="Location" Value="{Binding Location}"/>
                        <!-- Left/Center anchoring + the -4px margin on the content puts the 8px dot's center exactly on the route line -->
                        <Setter Property="HorizontalAlignment" Value="Left"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </map:MapItemsControl.ItemContainerStyle>
                <map:MapItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="-4,0,0,0" ToolTip="{Binding Tooltip}" ToolTipService.ShowDuration="10000">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource PlannedPathColorBrush}" Stroke="White" StrokeThickness="1"/>
                            <TextBlock Text="{Binding Ident}" Margin="4,0,0,0" FontSize="11" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource CurrentFont}"
                                       Foreground="{DynamicResource PlannedPathColorBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </map:MapItemsControl.ItemTemplate>
            </map:MapItemsControl>
            <!-- IVAO ATC polygons (bottom) -->
            <map:MapItemsControl ItemsSource="{Binding IvaoAtcList}" Visibility="{Binding IsShowIvaoAtc, Converter={StaticResource BoolToVis}}">
                <map:MapItemsControl.ItemTemplate>
                    <DataTemplate>
                        <map:MapPanel>
                            <map:MapPolygon Locations="{Binding ControlPolygon}"
                                            StrokeThickness="1"
                                            Opacity="0.35"
                                            Visibility="{Binding ControlPolygon, Converter={StaticResource NullToVis}}">
                                <map:MapPolygon.Style>
                                    <Style TargetType="map:MapPolygon">
                                        <Setter Property="Fill" Value="{DynamicResource IvaoAtcFillBrush}"/>
                                        <Setter Property="Stroke" Value="{DynamicResource IvaoAtcStrokeBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCtr}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource IvaoCtrFillBrush}"/>
                                                <Setter Property="Stroke" Value="{DynamicResource IvaoCtrStrokeBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </map:MapPolygon.Style>
                            </map:MapPolygon>
                        </map:MapPanel>
                    </DataTemplate>
                </map:MapItemsControl.ItemTemplate>
            </map:MapItemsControl>

            <!--  Vatsim UIRs -->
            <map:MapItemsControl ItemsSource="{Binding VatsimControlledUirs}" Visibility="{Binding IsShowVatsimFirs, Converter={StaticResource BoolToVis}}">
                <map:MapItemsControl.ItemTemplate>
                    <DataTemplate>
                        <map:MapPanel>
                            <map:MapItemsControl ItemsSource="{Binding FirLocations}">
                                <map:MapItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <map:MapPolygon
                                            Stroke="{DynamicResource VatsimUirFillBrush}"
                                            Fill="{DynamicResource VatsimUirFillBrush}"
                                            Opacity="0.3"
                                            Locations="{Binding}"/>
                                    </DataTemplate>
                                </map:MapItemsControl.ItemTemplate>
                            </map:MapItemsControl>
                        </map:MapPanel>
                    </DataTemplate>
                </map:MapItemsControl.ItemTemplate>
            </map:MapItemsControl>

            <!--  Vatsim FIRs -->
            <map:MapItemsControl ItemsSource="{Binding VatsimControlledFirs}" Visibility="{Binding IsShowVatsimFirs, Converter={StaticResource BoolToVis}}">
                <map:MapItemsControl.ItemTemplate>
                    <DataTemplate>
                        <map:MapPanel>
                            <ItemsControl ItemsSource="{Binding Locations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <map:MapPolygon
                                            Stroke="{DynamicResource VatsimFirStrokeBrush}"
                                            Fill="{DynamicResource VatsimFirFillBrush}"
                                            Opacity="0.3"
                                            Locations="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </map:MapPanel>

                    </DataTemplate>
                </map:MapItemsControl.ItemTemplate>
            </map:MapItemsControl>

            <!--  Vatsim TRACON polygons -->
            <map:MapItemsControl ItemsSource="{Binding VatsimControlledAirports}" Visibility="{Binding IsShowVatsimAirports, Converter={StaticResource BoolToVis}}">
                <map:MapItemsControl.ItemTemplate>
                    <DataTemplate>
                        <map:MapPanel Visibility="{Binding IsShowTraconPolygon, Converter={StaticResource BoolToVis}}">
                            <map:MapItemsControl ItemsSource="{Binding TraconPolygons}">
                                <map:MapItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <map:MapPolygon
                                            Stroke="{DynamicResource VatsimTraconStrokeBrush}"
                                            Fill="{DynamicResource VatsimTraconFillBrush}"
                                            Opacity="0.35"
                                            Locations="{Binding}"/>
                                    </DataTemplate>
                                </map:MapItemsControl.ItemTemplate>
                            </map:MapItemsControl>
                        </map:MapPanel>
                    </DataTemplate>
                </map:MapItemsControl.ItemTemplate>
            </map:MapItemsControl>

            <!--  Vatsim Airports - 80km circle fallback when no TRACON polygon available -->
            <map:MapItemsControl ItemsSource="{Binding VatsimControlledAirports}" Visibility="{Binding IsShowVatsimAirports, Converter={StaticResource BoolToVis}}">
                <map:MapItemsControl.ItemTemplate>
                    <DataTemplate>
                            <map:MapPolygon
                                Stroke="{DynamicResource VatsimAppCircleStrokeBrush}"
                                Fill="{DynamicResource VatsimAppCircleFillBrush}"
                                Opacity="0.3"
                                Visibility="{Binding IsShowCircle, Converter={StaticResource BoolToVis}}"
                                Locations="{Binding CircleLocations}"/>

                    </DataTemplate>
                </map:MapItemsControl.ItemTemplate>
            </map:MapItemsControl>

            <!-- IVAO ATC icons -->
            <map:MapItemsControl ItemsSource="{Binding IvaoAtcList}" Visibility="{Binding IsShowIvaoAtc, Converter={StaticResource BoolToVis}}">
                <map:MapItemsControl.ItemContainerStyle>
                    <Style TargetType="map:MapItem">
                        <Setter Property="Location" Value="{Binding Location}"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <EventSetter Event="MouseLeftButtonUp" Handler="OnMapItemClicked"/>
                    </Style>
                </map:MapItemsControl.ItemContainerStyle>
                <map:MapItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding IconResourse, Converter={StaticResource ResourceNameToImageConverter}}" Width="24" Height="24">
                            <Image.ToolTip>
                                <ToolTip Content="{Binding TooltipText}" />
                            </Image.ToolTip>
                        </Image>
                    </DataTemplate>
                </map:MapItemsControl.ItemTemplate>
            </map:MapItemsControl>

            <!-- Vatsim airport icons -->
            <map:MapItemsControl ItemsSource="{Binding VatsimControlledAirports}" Visibility="{Binding IsShowVatsimAirports, Converter={StaticResource BoolToVis}}">
                <map:MapItemsControl.ItemContainerStyle>
                    <Style TargetType="map:MapItem">
                        <Setter Property="Location" Value="{Binding Location}"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <EventSetter Event="MouseLeftButtonUp" Handler="OnMapItemClicked"/>
                    </Style>
                </map:MapItemsControl.ItemContainerStyle>
                <map:MapItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding Path=IconResourse, Converter={StaticResource ResourceNameToImageConverter}}" Width="32" Height="32">
                            <Image.ToolTip>
                                <ToolTip Content="{Binding TooltipText}" />
                            </Image.ToolTip>
                        </Image>
                    </DataTemplate>
                </map:MapItemsControl.ItemTemplate>
            </map:MapItemsControl>

            <!-- Labels - fir uir -->

            <map:MapItemsControl ItemsSource="{Binding VatsimControlledFirs}" Visibility="{Binding IsShowVatsimFirs, Converter={StaticResource BoolToVis}}">
                <map:MapItemsControl.ItemContainerStyle>
                    <Style TargetType="map:MapItem">
                        <Setter Property="Location" Value="{Binding LabelLocation}"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <EventSetter Event="MouseLeftButtonUp" Handler="OnMapItemClicked"/>
                    </Style>
                </map:MapItemsControl.ItemContainerStyle>
                <map:MapItemsControl.ItemTemplate>
                    <DataTemplate>
                        <map:MapContentControl>
                            <Label Content="{Binding  Label}"
                                   Foreground="{DynamicResource VatsimFirTextBrush}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                            >
                                <Label.ToolTip>
                                    <ToolTip Content="{Binding TooltipText}" FontWeight="Normal"/>
                                </Label.ToolTip>
                            </Label>
                        </map:MapContentControl>
                    </DataTemplate>
                </map:MapItemsControl.ItemTemplate>
            </map:MapItemsControl>

            <map:MapItemsControl ItemsSource="{Binding VatsimControlledUirs}" Visibility="{Binding IsShowVatsimFirs, Converter={StaticResource BoolToVis}}">
                <map:MapItemsControl.ItemContainerStyle>
                    <Style TargetType="map:MapItem">
                        <Setter Property="Location" Value="{Binding LabelLocation}"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <EventSetter Event="MouseLeftButtonUp" Handler="OnMapItemClicked"/>
                    </Style>
                </map:MapItemsControl.ItemContainerStyle>
                <map:MapItemsControl.ItemTemplate>
                    <DataTemplate>
                        <map:MapContentControl>
                            <Label Content="{Binding Label}"
                                   Foreground="{DynamicResource VatsimUirTextBrush}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                            >
                                <Label.ToolTip>
                                    <ToolTip Content="{Binding TooltipText}" FontWeight="Normal"/>
                                </Label.ToolTip>
                            </Label>
                        </map:MapContentControl>
                    </DataTemplate>
                </map:MapItemsControl.ItemTemplate>
            </map:MapItemsControl>

            <!-- IVAO Aircraft -->
            <map:MapItemsControl ItemsSource="{Binding IvaoAircraftList}" Visibility="{Binding IsShowIvaoPilots, Converter={StaticResource BoolToVis}}">
                <map:MapItemsControl.ItemContainerStyle>
                    <Style TargetType="map:MapItem">
                        <Setter Property="Location" Value="{Binding Location}"/>
                        <Setter Property="Margin" Value="-12 -12 0 0"/>
                        <EventSetter Event="MouseLeftButtonUp" Handler="OnMapItemClicked"/>
                    </Style>
                </map:MapItemsControl.ItemContainerStyle>
                <map:MapItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Path Fill="{DynamicResource IvaoAircraftColorBrush}"
                              Data="{Binding Icon, Converter={StaticResource ResourceNameToGeometryConverter}}">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform CenterX="16" CenterY="16" ScaleX="0.75" ScaleY="0.75"/>
                                    <RotateTransform CenterY="16" CenterX="16" Angle="{Binding Heading}"/>
                                </TransformGroup>
                            </Path.RenderTransform>
                            <Path.ToolTip>
                                <ToolTip Content="{Binding TooltipText}" />
                            </Path.ToolTip>
                        </Path>
                    </DataTemplate>
                </map:MapItemsControl.ItemTemplate>
            </map:MapItemsControl>

            <!-- Vatsim Aircraft (top network layer) -->
            <map:MapItemsControl ItemsSource="{Binding VatsimAircraftList}" Visibility="{Binding IsShowVatsimAircraft, Converter={StaticResource BoolToVis}}">
                <map:MapItemsControl.ItemContainerStyle>
                    <Style TargetType="map:MapItem">
                        <Setter Property="Location" Value="{Binding Location}"/>
                        <Setter Property="Margin" Value="-16 -16 0 0"/>
                        <EventSetter Event="MouseLeftButtonUp" Handler="OnMapItemClicked"/>
                    </Style>
                </map:MapItemsControl.ItemContainerStyle>
                <map:MapItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Path
                            Fill="{DynamicResource VatsimAicraftColorBrush}"
                            Data="{Binding Path=IconResource, Converter={StaticResource ResourceNameToGeometryConverter}}"
                        >
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform CenterX="16" CenterY="16" ScaleX="{Binding ScaleFactror}" ScaleY="{Binding ScaleFactror}"/>
                                    <RotateTransform CenterY="16" CenterX="16" Angle="{Binding Pilot.heading}"></RotateTransform>
                                </TransformGroup>
                            </Path.RenderTransform>
                            <Path.ToolTip>
                                <ToolTip Content="{Binding TooltipText}" />
                            </Path.ToolTip>
                        </Path>
                    </DataTemplate>
                </map:MapItemsControl.ItemTemplate>
            </map:MapItemsControl>

            <!-- map:MapGraticule Opacity="0.5"/ -->

            <!--  Aircraft Icon -->
            <map:MapContentControl Location="{Binding Location}"
                         Width="32" Height="32"
                         Margin="-16"
                         Visibility="{Binding Path=IsShowAirplane, Converter={StaticResource BoolToVis}}"
            >
                <Path x:Name="AirplaneGeometry" Fill="{DynamicResource FlightPathColorBrush}" Stroke="{DynamicResource FlightPathStrokeBrush}" StrokeThickness="1"/>
                <map:MapContentControl.RenderTransform>
                    <RotateTransform CenterX="16" CenterY="16" Angle="{Binding Heading, Mode=OneWay}" />
                </map:MapContentControl.RenderTransform>
            </map:MapContentControl>
            <map:MapPolyline Locations="{Binding FlightPath}" Stroke="{DynamicResource FlightPathColorBrush}" StrokeThickness="2" StrokeLineJoin="round"/>
            <map:MapPolyline Locations="{Binding LastSegmentLine}" Stroke="{DynamicResource FlightPathColorBrush}" StrokeThickness="2" Visibility="{Binding Path=IsShowAirplane, Converter={StaticResource BoolToVis}}"/>

            <!-- Selected client track (solid) -->
            <map:MapPolyline
                Locations="{Binding SelectedTrackLocations}"
                Stroke="{Binding SelectedClient.TrackStrokeColor, Converter={StaticResource StringToColorBrushConverter}}"
                StrokeThickness="2"
                StrokeLineJoin="Round"/>

            <!-- Selected client destination line (dashed) -->
            <map:MapPolyline
                Locations="{Binding SelectedDestinationLine}"
                Stroke="{Binding SelectedClient.TrackStrokeColor, Converter={StaticResource StringToColorBrushConverter}}"
                StrokeThickness="1.5"
                StrokeDashArray="4 4"
                StrokeLineJoin="Round"/>

        </map:Map>

        <views:ClientDetailPanelControl
            DataContext="{Binding SelectedClient}"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            Margin="0,0,16,16"
            Visibility="{Binding DataContext, RelativeSource={RelativeSource Self},
                         Converter={StaticResource NullToVisConverter}}"/>

        <StackPanel Margin="10" HorizontalAlignment="Left" MinWidth="160">
            <views:OverlayTextCardControl Header="{Binding ConnectionText}" Text="{Binding State}"/>
            <StackPanel Visibility="{Binding IsShowAirplane, Converter={StaticResource BoolToVis}}">
                <views:OverlayTextCardControl Header="Aircraft" Text="{Binding ActiveFlight.Aircraft}"/>
                <views:OverlayTextCardControl Header="Flight Parameters" Text="{Binding FlightParamsText}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Margin="10" HorizontalAlignment="Right">
            <ToggleButton Style="{DynamicResource MapToggleButton}" 
                          IsChecked="{Binding IsCenterOnAirplane}" 
                          Content="{DynamicResource CenterMap}">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="Checked">
                        <b:InvokeCommandAction Command="{Binding CenterOnAirplaneCommand}"/>
                    </b:EventTrigger>
                    <b:EventTrigger EventName="Unchecked">
                        <b:InvokeCommandAction Command="{Binding StopCenterOnAirplaneCommand}"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </ToggleButton>
            <!-- Network selector: VATSIM -->
            <ToggleButton Style="{DynamicResource MapToggleButton}"
                          IsChecked="{Binding IsVatsimActive, Mode=OneWay}">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="Click">
                        <b:InvokeCommandAction Command="{Binding SelectNetworkCommand}"
                                               CommandParameter="{x:Static dataTypes:NetworkType.Vatsim}"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>
                <Image Source="/Resources/Images/VATSIM_Logo_White_No_Tagline_500px.png" Width="46" />
            </ToggleButton>

            <!-- Network selector: IVAO -->
            <ToggleButton Style="{DynamicResource MapToggleButton}"
                          IsChecked="{Binding IsIvaoActive, Mode=OneWay}">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="Click">
                        <b:InvokeCommandAction Command="{Binding SelectNetworkCommand}"
                                               CommandParameter="{x:Static dataTypes:NetworkType.Ivao}"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>
                <ContentControl Content="{DynamicResource IvaoLogo}" Width="46"/>
            </ToggleButton>

            <!-- Pilots toggle -->
            <ToggleButton Style="{DynamicResource MapToggleButton}"
                          IsChecked="{Binding IsShowPilots}"
                          Visibility="{Binding IsAnyNetworkActive, Converter={StaticResource BoolToVis}}">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="Checked">
                        <b:InvokeCommandAction Command="{Binding EnableNetworkItemCommand}"/>
                    </b:EventTrigger>
                    <b:EventTrigger EventName="Unchecked">
                        <b:InvokeCommandAction Command="{Binding DisableNetworkItemCommand}"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>
                <TextBlock Foreground="{DynamicResource SuperBrightTextColor}">Pilots</TextBlock>
            </ToggleButton>

            <!-- ATC toggle -->
            <ToggleButton Style="{DynamicResource MapToggleButton}"
                          IsChecked="{Binding IsShowAtc}"
                          Visibility="{Binding IsAnyNetworkActive, Converter={StaticResource BoolToVis}}">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="Checked">
                        <b:InvokeCommandAction Command="{Binding EnableNetworkItemCommand}"/>
                    </b:EventTrigger>
                    <b:EventTrigger EventName="Unchecked">
                        <b:InvokeCommandAction Command="{Binding DisableNetworkItemCommand}"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>
                <TextBlock Foreground="{DynamicResource SuperBrightTextColor}">ATC</TextBlock>
            </ToggleButton>

            <!-- SimBrief plan overlay toggle - only exists when a matching plan was fetched -->
            <ToggleButton Style="{DynamicResource MapToggleButton}"
                          IsChecked="{Binding IsShowFlightPlan}"
                          Visibility="{Binding IsFlightPlanAvailable, Converter={StaticResource BoolToVis}}">
                <TextBlock Foreground="{DynamicResource SuperBrightTextColor}">Plan</TextBlock>
            </ToggleButton>
        </StackPanel>
    </Grid>
</UserControl>
