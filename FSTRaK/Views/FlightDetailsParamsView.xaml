<UserControl x:Class="FSTRaK.Views.FlightDetailsParamsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FSTRaK.Views"
             xmlns:viewModels="clr-namespace:FSTRaK.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewModels:FlightDetailsParamsViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <local:OverlayTextCardControl Header="Aircraft" Text="{Binding Aircraft}" Visibility="Visible"/>

        <Grid 
            Margin="5"
        >
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />

            </Grid.RowDefinitions>

            <Border 
                Background="{DynamicResource OverlayBackgroundBrush}" 
                Opacity="0.7"
                CornerRadius="5"
                Grid.Row="0" Grid.RowSpan="2"
            />
            <Label Grid.Row="0"
                   Foreground="{DynamicResource BrightTextColor}"
                   FontSize="{DynamicResource  HeaderFontSize}"
                   Margin="5"
                   FontFamily="{DynamicResource CurrentFont}"
                   Content="Flight Data"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
            />
            <TextBlock
                Grid.Row="1"
                Foreground="{DynamicResource BrightTextColor}"
                FontSize="{DynamicResource  TextFontSize}"
                Margin="5"
                FontFamily="{DynamicResource CurrentFont}"
                TextWrapping="Wrap"
                Text="{Binding FlightDataText}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                MaxWidth="300"
            />
            </Grid>

    </StackPanel>
</UserControl>
